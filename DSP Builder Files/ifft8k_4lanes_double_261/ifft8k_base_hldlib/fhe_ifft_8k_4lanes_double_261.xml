
<RTL_SPEC>

  <FUNCTION module="fhe_ifft_8k_4lanes_double_261_module" name="fhe_ifft_8k_4lanes_double_261">
    <ATTRIBUTES>
      <!--
        This RTL does not have a fixed latency: it accumulates a full
        frame (2048 beats) of input before starting computation, and
        outputs a burst of 2048 consecutive valid beats once done, all
        while a second frame's input may already be underway. With
        IS_STALL_FREE="no" and IS_FIXED_LATENCY="no", the compiler relies
        on the module's live ivalid/iready/ovalid/oready signals (now
        properly implemented in the wrapper's internal FIFO + admission
        control) rather than trusting a static latency number.
        EXPECTED_LATENCY and CAPACITY below are just scheduling estimates
        in this mode -- not functional guarantees -- but the spec still
        requires values >= 1 to be present.
      -->
      <IS_STALL_FREE value="no"/>
      <IS_FIXED_LATENCY value="no"/>
      <EXPECTED_LATENCY value="2048"/>
      <CAPACITY value="4096"/>
      <HAS_SIDE_EFFECTS value="yes"/>
      <ALLOW_MERGING value="yes"/>
    </ATTRIBUTES>
    <INTERFACE>
      <AVALON port="clock" type="clock"/>
      <AVALON port="resetn" type="resetn"/>
      <AVALON port="ivalid" type="ivalid"/>
      <AVALON port="iready" type="iready"/>
      <AVALON port="ovalid" type="ovalid"/>
      <AVALON port="oready" type="oready"/>
      <INPUT port="idata" width="528"/>
      <OUTPUT port="odata" width="528"/>
    </INTERFACE>
